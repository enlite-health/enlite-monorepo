# Copie pra terraform.tfvars (gitignored) antes de rodar init/plan/apply.
project_id       = "enlite-prd"
region           = "southamerica-west1"
scheduler_region = "southamerica-east1"

# Vazia no 1o apply; preencher com a URL do Cloud Run apos o 1o gcloud run deploy.
gestoras_service_url = ""

# E-mail da SA de deploy (identidade, nao segredo).
deploy_sa_email = "CHANGE_ME@enlite-prd.iam.gserviceaccount.com"
