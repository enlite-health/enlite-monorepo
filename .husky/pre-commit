echo "Pre-commit: verificando tipos e lint..."

# Husky/git hooks não herdam PATH do shell interativo — adiciona o NVM bin.
if [ -d "$HOME/.nvm/versions/node" ]; then
  NODE_BIN=$(ls -d "$HOME/.nvm/versions/node"/v*/bin 2>/dev/null | tail -1)
  if [ -n "$NODE_BIN" ]; then
    export PATH="$NODE_BIN:$PATH"
  fi
fi

echo ""
echo "========================================="
echo "  enlite-frontend: type-check (tsc)"
echo "========================================="
cd enlite-frontend
pnpm type-check || { echo "❌ enlite-frontend type-check falhou. Commit abortado."; exit 1; }

echo ""
echo "========================================="
echo "  enlite-frontend: lint (eslint)"
echo "========================================="
pnpm lint || { echo "❌ enlite-frontend lint falhou. Commit abortado."; exit 1; }

cd ..

echo ""
echo "========================================="
echo "  worker-functions: type-check (tsc)"
echo "========================================="
cd worker-functions
npx tsc --noEmit || { echo "❌ worker-functions type-check falhou. Commit abortado."; exit 1; }

cd ..

echo ""
echo "✅ Type-check e lint passaram! (build + testes completos rodam no pre-push)"
