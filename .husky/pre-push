# D459: local só o teste tocado — a suíte inteira e o build são do CI. Segundos, não minutos.
# A suíte completa de antes continua em `PRE_PUSH_COMPLETO=1 git push`.

# Husky/git hooks não herdam PATH do shell interativo — adiciona o NVM bin.
if [ -d "$HOME/.nvm/versions/node" ]; then
  NODE_BIN=$(ls -d "$HOME/.nvm/versions/node"/v*/bin 2>/dev/null | tail -1)
  if [ -n "$NODE_BIN" ]; then
    export PATH="$NODE_BIN:$PATH"
  fi
fi

# Heap default 2GB causa Abort trap 6 em test runs com muitos workers paralelos.
export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=4096"

if [ "${PRE_PUSH_COMPLETO:-}" != "1" ]; then
  echo "Pre-push: check rápido nos arquivos tocados (PRE_PUSH_COMPLETO=1 para a suíte completa)..."
  if bash scripts/check-rapido.sh; then
    echo "✅ Check rápido passou. Push liberado."
    exit 0
  fi
  echo "❌ Check rápido falhou. Push abortado."
  exit 1
fi

echo "Pre-push: verificando build e testes completos..."

echo ""
echo "========================================="
echo "  enlite-frontend: build (tsc + vite)"
echo "========================================="
cd enlite-frontend
pnpm build || { echo "❌ enlite-frontend build falhou. Push abortado."; exit 1; }

echo ""
echo "========================================="
echo "  enlite-frontend: testes unitarios"
echo "========================================="
pnpm test:run || { echo "❌ enlite-frontend testes falharam. Push abortado."; exit 1; }

cd ..

echo ""
echo "========================================="
echo "  worker-functions: build (tsc)"
echo "========================================="
cd worker-functions
npm run build || { echo "❌ worker-functions build falhou. Push abortado."; exit 1; }

echo ""
echo "========================================="
echo "  worker-functions: testes unitarios"
echo "========================================="
npm test || { echo "❌ worker-functions testes falharam. Push abortado."; exit 1; }

cd ..

echo ""
echo "✅ Todos os checks passaram! Push liberado."
