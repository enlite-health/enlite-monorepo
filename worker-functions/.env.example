DATABASE_URL=postgresql://enlite_admin:enlite_password@localhost:5432/enlite_production
N8N_WEBHOOK_URL=http://localhost:5678/webhook/worker-events

# Google Cloud Identity Platform (HIPAA-compliant)
GCP_PROJECT_ID=enlite-prd
GCS_BUCKET_NAME=enlite-worker-documents
GCP_REGION=southamerica-east1
IDENTITY_PLATFORM_API_KEY=AIza...
FIREBASE_PROJECT_ID=enlite-health-prod
ALLOWED_ORIGIN=http://localhost:3000

# Cloud KMS Configuration (HIPAA Encryption)
KMS_KEYRING=enlite-keyring
KMS_KEY_NAME=worker-data-key

NODE_ENV=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# URL configurada no Twilio Console para receber mensagens inbound do WhatsApp
TWILIO_INBOUND_WEBHOOK_URL=https://<domain>/api/webhooks/twilio/inbound

# Twilio Verify — OTP SMS para claim de ficha importada
# Canal atual: SMS (WhatsApp Sender da Enlite está offline no Twilio — WABA 4410859772526279,
# code 63111). Pra migrar pra WhatsApp depois: reativar sender + Messaging Service + trocar
# channel: 'sms' → 'whatsapp' em src/modules/auth/infrastructure/TwilioVerifyService.ts.
# Criado via CLI em 2026-06-01 — SID: VA1bf147391e12ad7f044a136c9e015b24
TWILIO_VERIFY_SERVICE_SID=VA1bf147391e12ad7f044a136c9e015b24
# Opcional — Content Template SID personalizado (HX...). Se omitido, usa o template genérico.
# TWILIO_VERIFY_TEMPLATE_SID=HX...

# E2E OTP bypass — APENAS dev local pra testes automatizados
# Quando 'true', startVerification retorna sid sintético sem chamar Twilio (zero custo)
# e checkVerification aceita E2E_OTP_CODE (default '123456'). Guard duro: ignorado
# automaticamente se a env K_SERVICE estiver setada (presente apenas no Cloud Run runtime).
# K_SERVICE NÃO é setada em dev local mesmo apontando GCP_PROJECT_ID=enlite-prd
# (que precisamos pra Firebase Auth real). Logs alarme se detectar leak em Cloud Run.
E2E_OTP_BYPASS=false
E2E_OTP_CODE=123456

# Webhook Partner Auth
# Habilita endpoints de teste em /api/webhooks-test/ (automático em dev)
ENABLE_TEST_WEBHOOKS=true

# Google Calendar API (para resolução de datetimes de Meet links)
# Em produção (Cloud Run) não é necessário — usa a service account anexada ao serviço.
# Em desenvolvimento local, aponte para o JSON da service account baixado do GCP Console.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
GOOGLE_CALENDAR_IMPERSONATE_EMAIL=enlite@enlite.health
USE_MOCK_GOOGLE_CALENDAR=false

# Internal Endpoints (Pub/Sub push, Cloud Tasks)
# INTERNAL_TOKEN_SECRET is shared with MultiAuthService — already defined above
CLOUD_TASKS_QUEUE_LOCATION=southamerica-west1
CLOUD_RUN_SERVICE_URL=http://localhost:8080

# Google Gemini API (vacancy text parsing via Gem)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Google Docs — vacancy prompt templates (document IDs)
# Share these docs with the service account: enlite-functions-sa@<PROJECT_ID>.iam.gserviceaccount.com
# Used by GeminiVacancyParserService (parsing + prescreening) AND
# TalentumDescriptionService (AI description for Talentum). Doc picked by
# `required_professions`: includes 'CAREGIVER' → CUIDADOR, otherwise AT.
PROMPT_DOC_ID_AT=1plk1zmW1kUI5kxudci5y1GcwMP5VI9exLe3avH0REGk
PROMPT_DOC_ID_CUIDADOR=1VSjf02LXjoxsNSNQSl-yDBIwiiu88w6aHW2DnKaUqgA

# Short.io — Social media link shortening with UTM tracking
SHORT_IO_API_KEY=
SHORT_IO_DOMAIN=go.enlite.health

# ClickUp — Personal API token (pk_...) for scripts/sync-vacantes-clickup.ts
# Gera em: ClickUp → Settings → Apps → API Token
CLICKUP_API_TOKEN=

# ClickUp Webhook HMAC secret (gerado pela ClickUp ao criar o webhook).
# Em prod vem do Secret Manager: gcloud secrets create clickup-webhook-secret.
# Setup: scripts/register-clickup-webhook.ts --endpoint <url>  (printa o secret).
# Sem essa env var, a rota POST /api/webhooks/clickup/patient não é registrada.
CLICKUP_WEBHOOK_SECRET=

# Hosts permitidos pra download externo de mídia (SSRF defense).
# Allowlist vazia = bloqueia tudo (fail-safe).
# Suporta wildcards. Exemplos:
ALLOWED_MEDIA_HOSTS=*.twilio.com,api.twilio.com,chatwoot.enlite.health

# Service principals para auth interno (API key per principal).
# Formato CSV: <principal-name>:<token>,<other-principal>:<other-token>
# Exemplo: triage-service:eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Em produção, vir do Secret Manager (mcp-principal-<name>) — esta env var é fallback dev.
ENLITE_API_KEYS=

# Lista de nomes de principals conhecidos (CSV) — usada pelo MCP pra descobrir secrets.
# Default: triage-service
MCP_PRINCIPAL_NAMES=triage-service