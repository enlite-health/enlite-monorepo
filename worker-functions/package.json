{
  "name": "worker-functions",
  "version": "1.0.0",
  "description": "Enlite Health Platform - Worker Cloud Functions",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:e2e": "jest --config jest.config.e2e.js",
    "test:e2e:watch": "jest --config jest.config.e2e.js --watch",
    "test:e2e:coverage": "jest --config jest.config.e2e.js --coverage",
    "migrate": "bash run_migrations.sh",
    "migrate:docker": "node scripts/run-migrations-docker.js",
    "geocode:jobs": "ts-node -r dotenv/config scripts/backfill-patient-addresses-geocoding.ts",
    "geocode:jobs:dry": "ts-node -r dotenv/config scripts/backfill-patient-addresses-geocoding.ts --dry-run",
    "backfill:worker-names": "ts-node -r dotenv/config scripts/backfill-worker-names-from-encuadres.ts",
    "backfill:worker-names:dry": "ts-node -r dotenv/config scripts/backfill-worker-names-from-encuadres.ts --dry-run",
    "sync:talentum": "ts-node -r dotenv/config scripts/sync-talentum-status.ts",
    "sync:talentum:dry": "ts-node -r dotenv/config scripts/sync-talentum-status.ts --dry-run",
    "sync:ana-care": "ts-node -r dotenv/config scripts/sync-ana-care-status.ts",
    "sync:ana-care:dry": "ts-node -r dotenv/config scripts/sync-ana-care-status.ts --dry-run",
    "sync:twilio-templates:dry": "ts-node -r dotenv/config scripts/sync-message-templates-twilio.ts --dry-run",
    "sync:twilio-templates": "ts-node -r dotenv/config scripts/sync-message-templates-twilio.ts --apply",
    "db:rewrap-passthrough": "ts-node -r dotenv/config scripts/rewrap-encrypted-passthrough.ts",
    "dev:local": "docker compose -f docker-compose.yml -f docker-compose.test.yml up -d postgres api",
    "test:e2e:stack:up": "docker compose -f docker-compose.yml -f docker-compose.test.yml -f docker-compose.firebase.yml up -d postgres firebase-emulator api",
    "test:e2e:stack:down": "docker compose -f docker-compose.yml -f docker-compose.test.yml -f docker-compose.firebase.yml down",
    "test:e2e:full": "npm run test:e2e:stack:up && USE_FIREBASE_EMULATOR=true FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 DATABASE_URL=postgresql://enlite_admin:enlite_password@localhost:5433/enlite_e2e npm run test:e2e; npm run test:e2e:stack:down",
    "test:e2e:docker": "docker compose -f docker-compose.yml -f docker-compose.test.yml up -d postgres api && node scripts/wait-for-health.js && npm run test:e2e; docker compose -f docker-compose.yml -f docker-compose.test.yml down",
    "test:e2e:reset": "docker compose -f docker-compose.yml -f docker-compose.test.yml down -v && docker compose -f docker-compose.yml -f docker-compose.test.yml up -d postgres api && node scripts/wait-for-health.js",
    "test:e2e:fixtures": "node scripts/generate-test-fixtures.js",
    "smoke:public-jobs": "ts-node -r tsconfig-paths/register scripts/smoke-public-jobs.ts",
    "test:playwright": "playwright test",
    "test:playwright:docker": "docker compose -f docker-compose.yml -f docker-compose.test.yml up -d postgres api && node scripts/wait-for-health.js && npx playwright test; EXIT=$?; docker compose -f docker-compose.yml -f docker-compose.test.yml down; exit $EXIT",
    "test:playwright:update-snapshots": "playwright test --update-snapshots"
  },
  "keywords": [
    "enlite",
    "health",
    "hipaa",
    "cloud-functions",
    "worker"
  ],
  "author": "Enlite Health",
  "license": "PRIVATE",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@google-cloud/functions-framework": "^3.3.0",
    "@google-cloud/kms": "^5.4.0",
    "@google-cloud/pubsub": "^5.3.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "@google-cloud/tasks": "^6.2.1",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.6.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.7.0",
    "google-auth-library": "^10.0.0",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.13.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/twilio": "^3.19.3",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
