# Firebase Configuration (Google Cloud Identity Platform)
# Get these from: Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Cerbos Authorization
VITE_CERBOS_URL=http://localhost:3592

# API Worker Functions URL
VITE_API_WORKER_FUNCTIONS_URL=http://localhost:3000

# Direct Cloud Run URL (bypasses Firebase Hosting's 60s timeout).
# Used only by long-running endpoints (e.g. generateAIContent). Falls back to
# VITE_API_WORKER_FUNCTIONS_URL if empty. In prod set to the *.run.app URL of
# worker-functions; locally leave empty.
VITE_API_WORKER_FUNCTIONS_DIRECT_URL=

# Google Maps API Key (for Places Autocomplete)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Microsoft Clarity (mapeamento de tela/heatmaps). Deixar vazio em dev/stage —
# só produção deve enviar sessões (ID injetado via build-arg no frontend-prd.yml).
VITE_CLARITY_PROJECT_ID=
