        <mxCell id="arrow_cli_db" style="endArrow=classic;html=1;rounded=0;strokeColor=#F57F17;strokeWidth=1;dashed=1;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cli_box" target="usecase_box">
          <mxGeometry relative="1" as="geometry" />
