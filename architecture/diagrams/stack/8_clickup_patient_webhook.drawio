        <mxCell id="legend" value="🟧 SaaS / GCP externo    🟦 Nosso código    🟥 Banco de dados    🟩 Observabilidade    🟪 Testes    🟨 Ferramentas ops" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#5F6368;" vertex="1" parent="1">
