<mxfile host="app.diagrams.net" modified="2026-05-08T16:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram id="webhook-macro" name="8A - Webhook ClickUp (macro)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="EnLite — 8A Webhook ClickUp → Patients (sync em tempo real)&#xa;Como uma edição no ClickUp vira UPDATE no banco em segundos" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="story" value="HISTÓRIA&#xa;&#xa;Operação trabalha primeiro no ClickUp (cadastra paciente, muda status). Antes, o sync só rodava manualmente a cada X horas — gap operacional.&#xa;Agora um webhook do ClickUp dispara em ~1s pra cada edição. O Cloud Run valida HMAC, busca a task completa, mapeia, persiste idempotente.&#xa;Falha de boolean/data silenciosa? Não mais — comprehensive test detecta. Sem PII em log. CLI continua como backfill quando webhook fica offline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7C3;strokeColor=#F59E0B;fontSize=13;fontColor=#78350F;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="clickup_box" value="ClickUp&#xa;&#xa;Lista &quot;Estado de Pacientes&quot;&#xa;(901304883903)&#xa;&#xa;Task pai = paciente&#xa;Child tasks = vagas (ignoradas)&#xa;&#xa;~30 custom_fields&#xa;Status: 11 valores&#xa;&#xa;(SaaS externo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;fontSize=12;fontColor=#E65100;strokeWidth=3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="220" height="220" as="geometry" />
        </mxCell>
        <mxCell id="event_label" value="taskCreated&#xa;taskUpdated&#xa;taskStatusUpdated&#xa;taskMoved&#xa;taskDeleted" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#5F6368;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="290" y="290" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hmac_label" value="POST + X-Signature&#xa;(HMAC-SHA256)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#1565C0;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="290" y="380" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="webhook_box" value="worker-functions / Cloud Run&#xa;&#xa;POST /api/webhooks/clickup/patient&#xa;&#xa;5 camadas de filtragem:&#xa;1. HMAC verify (X-Signature)&#xa;2. body.list_id correto&#xa;3. GET task completa (re-fetch)&#xa;4. task.list.id confere&#xa;5. parent === null (não-subtask)&#xa;&#xa;(nosso código + GCP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;fontColor=#0D47A1;strokeWidth=3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="260" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="usecase_box" value="SyncPatientFromClickUpTaskUseCase&#xa;&#xa;Orquestra:&#xa;• ClickUpPatientMapper.map(task)&#xa;• PatientService.upsertFromClickUp&#xa;&#xa;Retorna kind: CREATED / UPDATED&#xa;SKIPPED_* / CASE_NUMBER_CONFLICT / ERROR&#xa;&#xa;CorrelationId em todos os logs&#xa;PII-safe (sem patientName)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=12;fontColor=#0D47A1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="740" y="260" width="280" height="220" as="geometry" />
        </mxCell>
        <mxCell id="db_box" value="Cloud SQL — Postgres&#xa;&#xa;patients (clickup_task_id UNIQUE)&#xa;+ case_number UNIQUE parcial&#xa;+ deleted_at (soft-delete)&#xa;+ status canônico (ACTIVE/...)&#xa;&#xa;patient_addresses (geocoded)&#xa;patient_responsibles&#xa;patient_professionals&#xa;vacancy_relink_audit&#xa;&#xa;(GCP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=12;fontColor=#B71C1C;strokeWidth=3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="260" width="280" height="240" as="geometry" />
        </mxCell>
        <mxCell id="logs_box" value="Cloud Logging&#xa;&#xa;18 eventos estruturados:&#xa;clickup_webhook.received / hmac_invalid / skip_other_list / fetch_task_failed / task_deleted&#xa;clickup_patient_sync.start / completed / skipped / error / case_number_conflict&#xa;patient_service.upsert.start / completed / failed / case_number_conflict_retry&#xa;geocoding.failed / geocoding.batch_timeout&#xa;&#xa;Todos com correlationId, sem PII (firstName/lastName/phone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=12;fontColor=#1B5E20;strokeWidth=3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="640" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tests_box" value="Suite de validação (3 níveis)&#xa;&#xa;Nível 1 — Comprehensive fixture (unit, &lt;1s)&#xa;&#xa;Nível 2 — Real ClickUp → DB roundtrip (integration, ~5s)&#xa;Task seed 86ahcdkx2 [E2E_TEST_DO_NOT_EDIT]&#xa;&#xa;Nível 3 — E2E webhook (HMAC + handler + UseCase + DB, ~5s)&#xa;&#xa;1510 unit + 15 E2E + 4 smoke ao vivo passing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;fontSize=12;fontColor=#4A148C;strokeWidth=3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="540" width="620" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cli_box" value="CLI script (backfill)&#xa;&#xa;import-patients-from-clickup.ts&#xa;Replay quando webhook offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=11;fontColor=#F57F17;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="smoke_box" value="Smoke test executável&#xa;&#xa;scripts/smoke-test-clickup-webhook.ts&#xa;--target prod (HMAC simulado, valida updated_at)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=11;fontColor=#F57F17;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="780" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="health_box" value="Health endpoint&#xa;&#xa;GET /api/webhooks/clickup/patient/_health&#xa;Pra Cloud Monitoring uptime check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=11;fontColor=#F57F17;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="780" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="secret_box" value="Secret Manager&#xa;&#xa;clickup-webhook-secret&#xa;Mounted via --update-secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=11;fontColor=#F57F17;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="780" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="arrow_clickup_webhook" style="endArrow=classic;html=1;rounded=0;strokeColor=#1565C0;strokeWidth=2;" edge="1" parent="1" source="clickup_box" target="webhook_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow_webhook_usecase" style="endArrow=classic;html=1;rounded=0;strokeColor=#1565C0;strokeWidth=2;" edge="1" parent="1" source="webhook_box" target="usecase_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow_usecase_db" style="endArrow=classic;html=1;rounded=0;strokeColor=#C62828;strokeWidth=2;" edge="1" parent="1" source="usecase_box" target="db_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow_webhook_logs" style="endArrow=classic;html=1;rounded=0;strokeColor=#2E7D32;strokeWidth=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="webhook_box" target="logs_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow_usecase_logs" style="endArrow=classic;html=1;rounded=0;strokeColor=#2E7D32;strokeWidth=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="usecase_box" target="logs_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow_secret_webhook" style="endArrow=classic;html=1;rounded=0;strokeColor=#F57F17;strokeWidth=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="secret_box" target="webhook_box">
          <mxGeometry relative="1" as="geometry" />
